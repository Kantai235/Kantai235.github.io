{
  "name": "kantai235.github.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "乾太 (Kantai) 的個人網站與部落格",
  "scripts": {
    "build": "hugo --gc --minify --baseURL \"https://blog.init.engineer/\"",
    "build:preview": "hugo --gc --minify",
    "deploy:cloudflare:dry-run": "wrangler deploy --dry-run --env production",
    "lint": "eslint assets/js/",
    "lint:fix": "eslint assets/js/ --fix",
    "verify:agent-http": "bash scripts/check-agent-http.sh",
    "verify:agent-http:local": "bash scripts/check-agent-http-local.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kantai235/Kantai235.github.io.git"
  },
  "author": "KantaiDeveloper",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "wrangler": "^4.84.1"
  }
}
